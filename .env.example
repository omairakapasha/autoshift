# Supabase Configuration
REACT_APP_SUPABASE_URL=your_supabase_url_here
REACT_APP_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key_here

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_PHONE_NUMBER=+1234567890

# LLM via LiteLLM (choose one based on config.llm.provider)

# Google Gemini (FREE tier) — Recommended for getting started
# Get key: https://makersuite.google.com/app/apikeys
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI GPT-4
# OPENAI_API_KEY=sk-...your_key

# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...your_key

# Mistral AI
# MISTRAL_API_KEY=your_mistral_key

# Sentry — Error monitoring
REACT_APP_SENTRY_DSN=your_sentry_dsn_here

# Showroom Configuration
REACT_APP_SHOWROOM_NAME=Your Showroom Name
