{
  "name": "automobile-showroom",
  "version": "1.0.1",
  "description": "Automobile Showroom Management System",
  "main": "public/electron.js",
  "homepage": "./",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron-dev": "npm run rebuild:electron && concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "electron-pack": "npm run build && electron-builder build --win --publish never",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "test:db": "jest --config jest.electron.config.js"
  },
  "build": {
    "appId": "com.autoshift.showroom",
    "productName": "AutoShift",
    "files": [
      "build/**/*",
      "public/electron.js",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ]
  },
  "keywords": [
    "react",
    "automobile",
    "showroom",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/anthropic": "^0.2.0",
    "@langchain/core": "^0.2.0",
    "@langchain/langgraph": "^0.2.0",
    "@sentry/react": "^10.51.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.0",
    "langchain": "^0.2.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "twilio": "^4.21.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "fake-indexeddb": "^6.2.5",
    "jest": "^30.3.0",
    "wait-on": "^9.0.5"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
